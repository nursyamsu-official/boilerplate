# DATABASE_URL
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-32-plus-character-secret" # run on vps "openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000" # For Development
# BETTER_AUTH_URL="https://boilerplate.masterhub.id" # For Production use web url which google oauth will redirect to

# Better Auth Social Providers
# Reference: https://better-auth.com/docs/authentication/google
# https://console.cloud.google.com/apis/dashboard

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (Email)
# -------------------------- EMAIL --------------------------

# Resend - Transactional email service
# Free tier: 3,000 emails/month, 100 emails/day
#
# Setup Resend:
# 1. Go to https://resend.com and create an account
# 2. Add and verify your domain: Domains → Add Domain
#    - Add the DNS records (MX, TXT) to your domain registrar
#    - Wait for verification (usually a few minutes)
# 3. Create an API key: API Keys → Create API Key
#    - Permission: Sending access (or Full access)
# 4. Set EMAIL_FROM to an address on your verified domain
#
# For development, you can use Resend's test domain:
# EMAIL_FROM="onboarding@resend.dev" (only sends to your account email)
#
# Note: Contact email, phone and address are configured in config/app.config.ts     # need to check 
# (Previously NEXT_PUBLIC_CONTACT_EMAIL was an env variable - now in app.config.ts) # need to check
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@yourdomain.com"
